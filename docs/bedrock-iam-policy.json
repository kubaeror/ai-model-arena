{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBedrockInvokeInAllowedRegions",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "bedrock:Converse",
        "bedrock:ConverseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:eu-west-1::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:eu-west-3::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:ap-northeast-1::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:ap-southeast-1::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:us-east-1::foundation-model/amazon.titan-*",
        "arn:aws:bedrock:us-west-2::foundation-model/amazon.titan-*",
        "arn:aws:bedrock:us-east-1::foundation-model/meta.llama*",
        "arn:aws:bedrock:us-west-2::foundation-model/meta.llama*",
        "arn:aws:bedrock:us-east-1::foundation-model/mistral.mistral*",
        "arn:aws:bedrock:us-west-2::foundation-model/mistral.mistral*",
        "arn:aws:bedrock:us-east-1::foundation-model/cohere.command*",
        "arn:aws:bedrock:us-west-2::foundation-model/cohere.command*",
        "arn:aws:bedrock:us-east-1::foundation-model/ai21.jamba*",
        "arn:aws:bedrock:us-west-2::foundation-model/ai21.jamba*"
      ],
      "Condition": {
        "StringEqualsIfExists": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-west-2",
            "eu-west-1",
            "eu-west-3",
            "ap-northeast-1",
            "ap-southeast-1"
          ]
        }
      }
    },
    {
      "Sid": "AllowBedrockModelDiscovery",
      "Effect": "Allow",
      "Action": [
        "bedrock:ListFoundationModels",
        "bedrock:GetFoundationModel",
        "bedrock:GetFoundationModelAvailability"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyBedrockProvisioningAndMutation",
      "Effect": "Deny",
      "Action": [
        "bedrock:Create*",
        "bedrock:Delete*",
        "bedrock:Put*",
        "bedrock:Tag*",
        "bedrock:Untag*",
        "bedrock:Update*",
        "bedrock:Associate*",
        "bedrock:Disassociate*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyInvokeInUnapprovedRegions",
      "Effect": "Deny",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "bedrock:Converse",
        "bedrock:ConverseStream"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEqualsIfExists": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-west-2",
            "eu-west-1",
            "eu-west-3",
            "ap-northeast-1",
            "ap-southeast-1"
          ]
        }
      }
    },
    {
      "Sid": "AllowSTSforIdentityValidation",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}
